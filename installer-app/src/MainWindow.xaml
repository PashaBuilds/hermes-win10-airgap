<Window x:Class="HermesKurulum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermes Kurulum Asistanı" Width="1080" Height="740" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0" Background="#0F172A" Padding="22,14">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Accent}" Margin="0,0,14,0">
                        <TextBlock Text="H" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Hermes Kurulum Asistanı" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="İnternetsiz kurulum ve güncelleme · şirket sertifikası · model bağlantısı" Foreground="#94A3B8" FontSize="12.5"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="14" Padding="12,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Kurulu  " Foreground="#94A3B8" FontSize="12.5"/>
                            <TextBlock x:Name="ChipInstalled" Text="…" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="→" Foreground="#64748B" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="#1E3A8A" CornerRadius="14" Padding="12,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Paket  " Foreground="#BFDBFE" FontSize="12.5"/>
                            <TextBlock x:Name="ChipBundle" Text="seçilmedi" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= SIDEBAR ================= -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="18,22,18,16">
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Text="Kayıt dosyası" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="LogPathText" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <Button Content="Kayıt klasörünü aç" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="-4,4,0,0" Click="OpenLogFolder_Click"/>
                    </StackPanel>
                    <ItemsControl x:Name="StepsList" DockPanel.Dock="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="14" Background="{Binding CircleBrush}" BorderBrush="{Binding CircleBorder}" BorderThickness="2" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="1" Background="{Binding RowBrush}" CornerRadius="8" Padding="10,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="{Binding TitleWeight}" Foreground="{Binding TitleBrush}"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- ================= CONTENT ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="PageScroller" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="28,24,28,8">
                    <Grid>
                        <!-- ===== PAGE 1: PACKAGE ===== -->
                        <StackPanel x:Name="PagePackage">
                            <TextBlock Text="1. Hermes paketini seçin" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Lead}" Text="Aktarılan HermesAirgapBundle_&lt;sürüm&gt;_Win10_Desktop.zip dosyasını ya da onun açılmış klasörünü seçin. Asistan paketi kontrol eder, açar ve paketin kendi kurulum betiğini (InstallOrUpdateHermesAirgapped Auto CleanVenv) çalıştırır."/>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Paket (ZIP veya klasör)" Style="{StaticResource Label}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Klasör seç…" Style="{StaticResource Secondary}" Margin="8,0,0,0" Click="PickBundleFolder_Click"/>
                                        <Button DockPanel.Dock="Right" Content="ZIP seç…" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="PickBundleZip_Click"/>
                                        <TextBox x:Name="BundlePathBox" IsReadOnly="True" Text=""/>
                                    </DockPanel>
                                    <Border x:Name="BundleInfoPanel" Visibility="Collapsed" Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Paket sürümü" Style="{StaticResource Label}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InfoBundleVersion" Style="{StaticResource Value}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="1" Text="Bu bilgisayarda" Style="{StaticResource Label}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="InfoInstalled" Style="{StaticResource Value}"/>
                                            <TextBlock Grid.Row="2" Text="Yapılacak işlem" Style="{StaticResource Label}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="InfoAction" Style="{StaticResource Value}" FontWeight="SemiBold" Foreground="{StaticResource AccentDark}"/>
                                            <TextBlock Grid.Row="3" Text="Boyut" Style="{StaticResource Label}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="InfoSize" Style="{StaticResource Value}"/>
                                            <TextBlock Grid.Row="4" Text="SHA256 kontrolü" Style="{StaticResource Label}"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="InfoSha" Style="{StaticResource Value}"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="BundleError" Foreground="{StaticResource Bad}" Margin="0,10,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ExtractCard" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="ZIP'in açılacağı klasör" Style="{StaticResource Label}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Değiştir…" Style="{StaticResource Secondary}" Margin="8,0,0,0" Click="PickExtractFolder_Click"/>
                                        <TextBox x:Name="ExtractPathBox" Text="C:\Tools\HermesAirgapBundle" TextChanged="ExtractPathBox_TextChanged"/>
                                    </DockPanel>
                                    <TextBlock x:Name="ExtractHint" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"
                                               Text="Kısa bir yol seçin (Windows 260 karakter yol sınırı). %LOCALAPPDATA%\hermes içine açmayın."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <CheckBox x:Name="SkipInstallCheck" Content="Kurulum / güncellemeyi atla — yalnızca sertifika ve model ayarını yap" Checked="SkipInstall_Changed" Unchecked="SkipInstall_Changed"/>
                                    <TextBlock FontSize="12" Foreground="{StaticResource Muted}" Margin="22,0,0,0"
                                               Text="Hermes zaten kuruluysa ve sadece sertifikayı yenilemek ya da modeli değiştirmek istiyorsanız işaretleyin. Paket seçmek gerekmez."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== PAGE 2: CERTIFICATE ===== -->
                        <StackPanel x:Name="PageCert" Visibility="Collapsed">
                            <TextBlock Text="2. Şirket sertifikası" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Lead}" Text="Şirketinizin iç sitesinden indirdiğiniz kök sertifika dosyasını (.crt / .cer / .pem) seçin. Dosyanın adı önemli değil; yeniden adlandırmanıza veya bir klasöre kopyalamanıza gerek yok. Bu adım olmadan Hermes şirket içi model sunucusuna bağlanırken sertifika hatası verebilir."/>
                            <Border x:Name="ExistingCertPanel" Visibility="Collapsed" CornerRadius="10" Padding="16" Margin="0,0,0,14" Background="{StaticResource GoodSoft}">
                                <DockPanel>
                                    <Button x:Name="ReinstallCertBtn" DockPanel.Dock="Right" VerticalAlignment="Top" Content="Yeni sertifika seç / yeniden kur" Style="{StaticResource Secondary}" Margin="12,0,0,0" Click="PickCert_Click"/>
                                    <StackPanel>
                                        <TextBlock x:Name="ExistingCertTitle" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock x:Name="ExistingCertDetail" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12.5"/>
                                        <TextBlock x:Name="ExistingCertMissing" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12.5"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock x:Name="CertFileLabel" Text="Sertifika dosyası" Style="{StaticResource Label}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Sertifika seç…" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="PickCert_Click"/>
                                        <TextBox x:Name="CertPathBox" IsReadOnly="True"/>
                                    </DockPanel>
                                    <Border x:Name="CertInfoPanel" Visibility="Collapsed" CornerRadius="8" Padding="14" Margin="0,14,0,0" Background="{StaticResource GoodSoft}">
                                        <StackPanel>
                                            <TextBlock x:Name="CertStatus" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                            <ItemsControl x:Name="CertList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Text="Konu" Style="{StaticResource Label}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Subject}" FontWeight="SemiBold"/>
                                                            <TextBlock Grid.Row="1" Text="Veren" Style="{StaticResource Label}"/>
                                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Issuer}"/>
                                                            <TextBlock Grid.Row="2" Text="Tür" Style="{StaticResource Label}"/>
                                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Kind}"/>
                                                            <TextBlock Grid.Row="3" Text="Geçerlilik" Style="{StaticResource Label}"/>
                                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Validity}"/>
                                                            <TextBlock Grid.Row="4" Text="SHA-256 parmak izi" Style="{StaticResource Label}"/>
                                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Fingerprint}" FontFamily="Consolas" FontSize="11.5"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="CertMessages" FontSize="12.5"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <CheckBox x:Name="StoreCheck" IsChecked="True" Content="Windows kullanıcı sertifika deposuna da ekle (önerilir)"/>
                                    <TextBlock FontSize="12" Foreground="{StaticResource Muted}" Margin="22,0,0,8"
                                               Text="Hermes 0.23.4 Windows'un kendi sertifika doğrulamasını da kullanır; masaüstü uygulaması ve tarayıcı aracı da bu depoya bakar. Yalnızca sizin kullanıcı hesabınıza eklenir, yönetici yetkisi gerekmez. Windows bir onay penceresi açarsa &quot;Evet&quot;e basın."/>
                                    <CheckBox x:Name="SkipCertCheck" Content="Sertifika adımını atla (sertifika zaten kurulu)" Checked="SkipCert_Changed" Unchecked="SkipCert_Changed"/>
                                    <TextBlock x:Name="CurrentCertText" FontSize="12" Foreground="{StaticResource Muted}" Margin="22,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== PAGE 3: RUN ===== -->
                        <StackPanel x:Name="PageRun" Visibility="Collapsed">
                            <TextBlock x:Name="RunTitle" Text="3. Kurulum / güncelleme" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="RunLead" Style="{StaticResource Lead}" Text="Lütfen bekleyin. Bu sırada Hermes'i açmayın."/>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock x:Name="OverallPercent" DockPanel.Dock="Right" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Text="0%"/>
                                        <StackPanel>
                                            <TextBlock x:Name="CurrentPhase" FontSize="15" FontWeight="SemiBold" Text="Hazırlanıyor…"/>
                                            <TextBlock x:Name="CurrentDetail" FontSize="12.5" Foreground="{StaticResource Muted}" Text=" "/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar x:Name="OverallBar" Minimum="0" Maximum="100" Value="0"/>
                                    <ItemsControl x:Name="TaskList" Margin="0,16,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="24" Height="24" CornerRadius="12" Background="{Binding CircleBrush}" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Glyph}" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{Binding TitleBrush}"/>
                                                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Duration}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Top" Margin="10,2,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border x:Name="RunErrorPanel" Visibility="Collapsed" Background="{StaticResource BadSoft}" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                                        <TextBlock x:Name="RunErrorText" Foreground="{StaticResource Bad}" FontSize="13"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Expander x:Name="LogExpander" Header="Ayrıntılı kayıt (canlı)" IsExpanded="False" Margin="0,0,0,14" FontSize="13">
                                <TextBox x:Name="LogBox" IsReadOnly="True" Height="230" FontFamily="Consolas" FontSize="11.5" Background="#0B1220" Foreground="#CBD5E1"
                                         BorderThickness="0" Padding="10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="0,8,0,0"/>
                            </Expander>
                        </StackPanel>

                        <!-- ===== PAGE 4: MODEL ===== -->
                        <StackPanel x:Name="PageModel" Visibility="Collapsed">
                            <TextBlock Text="4. Model bağlantısı" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Lead}" Text="`hermes model` → Custom endpoint adımlarının aynısı: adres ve anahtarı girin, modelleri getirin, birini seçin. Ayarı Hermes'in kendi kodu kaydeder: anahtar yalnızca Hermes'in .env dosyasına yazılır, config.yaml sadece ona referans verir. Anahtar ekranda ve kayıt dosyasında görünmez."/>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <CheckBox x:Name="ModelEnableCheck" IsChecked="True" Content="Model bağlantısını şimdi ayarla" Checked="ModelEnable_Changed" Unchecked="ModelEnable_Changed"/>
                                    <TextBlock x:Name="CurrentModelText" FontSize="12" Foreground="{StaticResource Muted}" Margin="22,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ModelForm" Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                        <TextBlock Text="API base URL" Style="{StaticResource Label}"/>
                                        <Grid>
                                            <TextBox x:Name="BaseUrlBox" TextChanged="ModelInput_Changed"/>
                                            <TextBlock Text="https://llm.example.internal/v1" Foreground="#94A3B8" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                       x:Name="BaseUrlPlaceholder"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                        <TextBlock Text="API anahtarı (gizli)" Style="{StaticResource Label}"/>
                                        <DockPanel>
                                            <Button x:Name="FetchModelsBtn" DockPanel.Dock="Right" Content="Modelleri getir" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="FetchModels_Click"/>
                                            <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKey_Changed"/>
                                        </DockPanel>
                                        <TextBlock x:Name="ProbeStatus" FontSize="12.5" Margin="0,6,0,0" Foreground="{StaticResource Muted}"
                                                   Text="Anahtar boş bırakılabilir (sunucu istemiyorsa)."/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                                        <TextBlock Text="Model" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="ModelCombo" IsEditable="True" TextBoxBase.TextChanged="ModelCombo_Changed" SelectionChanged="ModelCombo_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                        <TextBlock Text="API uyumluluk modu" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="ApiModeCombo" SelectedIndex="0">
                                            <ComboBoxItem Content="Otomatik algıla (önerilen)" Tag=""/>
                                            <ComboBoxItem Content="Chat Completions" Tag="chat_completions"/>
                                            <ComboBoxItem Content="Responses / Codex" Tag="codex_responses"/>
                                            <ComboBoxItem Content="Anthropic Messages" Tag="anthropic_messages"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="0">
                                        <TextBlock Text="Görünen ad (isteğe bağlı)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="DisplayNameBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="2">
                                        <TextBlock Text="Bağlam uzunluğu (boş = otomatik)" Style="{StaticResource Label}"/>
                                        <TextBox x:Name="ContextLenBox"/>
                                    </StackPanel>
                                    <Border Grid.Row="4" Grid.ColumnSpan="3" x:Name="ModelResultPanel" Visibility="Collapsed" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                                        <TextBlock x:Name="ModelResultText" FontSize="13"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ===== PAGE 5: SUMMARY ===== -->
                        <StackPanel x:Name="PageSummary" Visibility="Collapsed">
                            <Border x:Name="SummaryBanner" CornerRadius="12" Padding="20" Margin="0,0,0,16" Background="{StaticResource GoodSoft}">
                                <DockPanel>
                                    <Border x:Name="SummaryIcon" Width="46" Height="46" CornerRadius="23" Background="{StaticResource Good}" DockPanel.Dock="Left" Margin="0,0,16,0">
                                        <TextBlock x:Name="SummaryGlyph" Text="✓" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="SummaryTitle" Text="Hermes hazır" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SummaryLead" FontSize="13" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <ItemsControl x:Name="SummaryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" Style="{StaticResource Label}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13.5"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Hermes'i aç" Style="{StaticResource Label}"/>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button x:Name="OpenDesktopBtn" Content="Masaüstü uygulaması" Style="{StaticResource Primary}" Margin="0,0,8,8" Click="OpenDesktop_Click"/>
                                        <Button x:Name="OpenDashboardBtn" Content="hermes dashboard" Style="{StaticResource Secondary}" Margin="0,0,8,8" Click="OpenDashboard_Click"/>
                                        <Button x:Name="OpenChatBtn" Content="hermes chat" Style="{StaticResource Secondary}" Margin="0,0,8,8" Click="OpenChat_Click"/>
                                        <Button Content="Kayıt dosyası" Style="{StaticResource Secondary}" Margin="0,0,8,8" Click="OpenLogFile_Click"/>
                                    </WrapPanel>
                                    <TextBlock FontSize="12" Foreground="{StaticResource Muted}" Text="Yeni açacağınız komut satırlarında `hermes` doğrudan çalışır (PATH güncellendi). Zaten açık olan pencereler eski ayarları görür."/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="UpdateSkippedCard" Visibility="Collapsed" CornerRadius="10" Padding="16" Margin="0,0,0,14" Background="{StaticResource WarnSoft}">
                                <DockPanel>
                                    <Button x:Name="RunUpdateBtn" DockPanel.Dock="Right" Content="Geri dön ve güncellemeyi yap" Style="{StaticResource Primary}" Click="RunUpdate_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock x:Name="UpdateSkippedTitle" FontWeight="SemiBold" Foreground="{StaticResource Warn}" FontSize="14"/>
                                        <TextBlock x:Name="UpdateSkippedText" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border x:Name="RollbackCard" Style="{StaticResource CardBorder}">
                                <DockPanel>
                                    <Button x:Name="RollbackBtn" DockPanel.Dock="Right" Content="Son güncellemeyi geri al" Style="{StaticResource Danger}" Click="Rollback_Click" VerticalAlignment="Center"/>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Bir sorun mu var?" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="12" Foreground="{StaticResource Muted}" Text="Önceki sürüm ve ayarlar yedekte duruyor. Geri alma, paketin kendi geri alma modunu çalıştırır (RollbackHermesAirgapped.bat ile aynı); oturumlar, beceriler ve hafıza silinmez."/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ================= FOOTER ================= -->
                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,12">
                    <DockPanel>
                        <Button x:Name="NextBtn" DockPanel.Dock="Right" Content="İleri  →" Style="{StaticResource Primary}" MinWidth="150" Click="Next_Click"/>
                        <Button x:Name="BackBtn" DockPanel.Dock="Right" Content="←  Geri" Style="{StaticResource Secondary}" Margin="0,0,10,0" MinWidth="100" Click="Back_Click"/>
                        <TextBlock x:Name="FooterHint" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
